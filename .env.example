# ---- 基本 ----
DOMAIN=ops.example.com
BASE_URL=https://ops.example.com
# ランダムな長い文字列にする（例：python -c "import secrets;print(secrets.token_urlsafe(48))"）
SESSION_SECRET=change-me
APP_ENV=production
# 既存ジョブとポートが衝突する場合は変更する
HTTP_PORT=80
HTTPS_PORT=443
# GHCR 等にビルド済みイメージを置く場合
# APP_IMAGE=ghcr.io/hegelgelda/ebayopssystem:latest
# 背景除去（rembg）をイメージに含めるか（1/0）と、実行時に使うか
INSTALL_REMBG=1
ENABLE_REMBG=1
# u2net（標準・約1.3GB）/ u2netp（軽量）
REMBG_MODEL=u2net
WORKER_MEM_LIMIT=2g

# ---- Discord ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ORDERS=
DISCORD_CHANNEL_LISTING=
DISCORD_CHANNEL_DAILY=
DISCORD_CHANNEL_WEEKLY=
DISCORD_CHANNEL_SYSTEM=
DISCORD_ROLE_LV1=
DISCORD_ROLE_LV2=

# ---- PSA（任意。Public API のトークンがあればスクレイピングより優先） ----
PSA_API_TOKEN=

# ---- バックアップ（S3互換オブジェクトストレージ。板記録と同じバケットの別プレフィックス） ----
S3_ENDPOINT_URL=https://ewr1.vultrobjects.com
S3_BUCKET=
S3_PREFIX=ebay-ops/
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
BACKUP_RETENTION_DAYS=30
# VPS内に残す日数（S3設定時のみ有効。未設定時はS3が無いため BACKUP_RETENTION_DAYS 日分をVPS内に残す）
LOCAL_BACKUP_RETENTION_DAYS=3

# ---- 開発用（本番では使わない） ----
# APP_ENV=dev
# DEV_LOGIN=1
